}
QPushButton {
    background-color: #2d2e30;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 22px;
    min-height: 56px;
}
QPushButton:hover {
    background-color: #3c3d40;
}
QPushButton:pressed {
    background-color: #505256;
}
QPushButton#buttonAdd, QPushButton#buttonSubtract, QPushButton#buttonMultiply, QPushButton#buttonDivide, QPushButton#buttonEquals {
    background-color: #ff9f0a;
    font-size: 26px;
    font-weight: 600;
}
QPushButton#buttonAdd:hover, QPushButton#buttonSubtract:hover, QPushButton#buttonMultiply:hover, QPushButton#buttonDivide:hover, QPushButton#buttonEquals:hover {
    background-color: #ffb340;
}
QPushButton#buttonAdd:pressed, QPushButton#buttonSubtract:pressed, QPushButton#buttonMultiply:pressed, QPushButton#buttonDivide:pressed, QPushButton#buttonEquals:pressed {
    background-color: #e08c00;
}
QPushButton#buttonClear, QPushButton#buttonBackspace {
    background-color: #5f6368;
}
QPushButton#buttonClear:hover, QPushButton#buttonBackspace:hover {
    background-color: #75797e;
}</string>
